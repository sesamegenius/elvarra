generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ContactStatus {
  UNREAD
  READ
  ANSWERED
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model ContactQuery {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  vousEtes           VousEtes
  objet              ObjetDemande
  typeSinistre       TypeSinistre?
  dateSinistre       DateTime?
  expertiseStatut    ExpertiseStatut?
  expertiseDate      DateTime?
  propositionStatut  PropositionStatut?
  codePostal         String
  fullName           String
  company            String?
  phone              String
  email              String
  content            String
  consentObligatoire Boolean            @default(false)
  consentFacultatif  Boolean            @default(false)
  status             ContactStatus      @default(UNREAD)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("contact_queries")
}

enum VousEtes {
  PARTICULIER
  PROFESSIONNEL
  GESTIONNAIRE
}

enum ObjetDemande {
  SINISTRE_RECENT
  EXPERTISE_PROGRAMMEE
  PROPOSITION_RECUE
  DESACCORD
  ELVARRA_GESTION
  AUTRE
}

enum TypeSinistre {
  INCENDIE
  DEGAT_DES_EAUX
  EVENEMENT_CLIMATIQUE
  AUTRE
  NON_APPLICABLE
}

enum ExpertiseStatut {
  NON
  PROGRAMMEE
  REALISEE
  NE_SAIT_PAS
}

enum PropositionStatut {
  NON
  OUI
  NE_SAIT_PAS
}